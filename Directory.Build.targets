<Project>
  <Import Project="Sdk.targets" Sdk="Microsoft.DotNet.Arcade.Sdk" />

  <!--
    Resolve WinForms references (Accessibility, System.Windows.Forms, etc.)
    via a target instead of a top-level ItemGroup so that the inline task in
    Directory.Build.props has already set $(WpfWindowsDesktopReferencePath).
  -->
  <Target Name="AddWindowsDesktopReferences"
          BeforeTargets="ResolveAssemblyReferences"
          Condition="'$(WpfWindowsDesktopReferencePath)' != '' and '@(MicrosoftPrivateWinFormsReference)' != ''">
    <ItemGroup>
      <Reference Include="@(MicrosoftPrivateWinFormsReference->'$(WpfWindowsDesktopReferencePath)%(Identity).dll')"
                 Private="false">
        <Private>false</Private>
      </Reference>
    </ItemGroup>
  </Target>

  <Target Name="RemoveInboxWpfReference"
          AfterTargets="ResolveReferences">
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)"
                     Condition="('%(ReferencePath.Filename)' == 'WindowsBase' or '%(ReferencePath.Filename)' == 'PresentationCore' or '%(ReferencePath.Filename)' == 'PresentationFramework' or '%(ReferencePath.Filename)' == 'ReachFramework' or '%(ReferencePath.Filename)' == 'System.Printing') and ('%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.NETCore.App' or '%(ReferencePath.FrameworkReferenceName)' == 'Microsoft.WindowsDesktop.App')" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)"
                                      Condition="('%(ReferencePathWithRefAssemblies.Filename)' == 'WindowsBase' or '%(ReferencePathWithRefAssemblies.Filename)' == 'PresentationCore' or '%(ReferencePathWithRefAssemblies.Filename)' == 'PresentationFramework' or '%(ReferencePathWithRefAssemblies.Filename)' == 'ReachFramework' or '%(ReferencePathWithRefAssemblies.Filename)' == 'System.Printing') and ('%(ReferencePathWithRefAssemblies.FrameworkReferenceName)' == 'Microsoft.NETCore.App' or '%(ReferencePathWithRefAssemblies.FrameworkReferenceName)' == 'Microsoft.WindowsDesktop.App')" />
    </ItemGroup>
  </Target>

  <Target Name="RemovePrebuiltPresentationBuildTasksReference"
          BeforeTargets="AssignProjectConfiguration;ResolveProjectReferences"
          Condition="'$(UsePrebuiltPresentationBuildTasks)' == 'true'">
    <ItemGroup>
      <ProjectReference Remove="$(WpfSourceDir)PresentationBuildTasks\PresentationBuildTasks.csproj" />
    </ItemGroup>
  </Target>

  <Target Name="VerifyPerlCommand" Condition="'@(WpfPerlScript)' != ''">
    <Exec Command="where.exe $(PerlCommand)" IgnoreExitCode="true" ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="PerlCommandExitCode" />
    </Exec>
    <PropertyGroup>
      <WpfPerlCommandAvailable Condition="'$(PerlCommandExitCode)' == '0'">true</WpfPerlCommandAvailable>
      <WpfPerlCommandAvailable Condition="'$(PerlCommandExitCode)' != '0'">false</WpfPerlCommandAvailable>
    </PropertyGroup>
    <Warning Condition="'$(WpfPerlCommandAvailable)' != 'true'" Text="Perl is not available; skipping WPF build script(s): @(WpfPerlScript). Install Perl or set PerlCommand to a valid Perl executable to regenerate these files. The build does not execute .pl files directly because Windows may open them through file association." />
  </Target>
</Project>
