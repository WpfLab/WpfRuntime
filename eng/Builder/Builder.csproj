<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <!-- Builder 自身输出不能落在 artifacts\ 内，避免清空时自毁 -->
    <OutputPath>$(MSBuildThisFileDirectory)bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Runtime.win-x64" Version="[8.0.6]" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Runtime.win-x86" Version="[8.0.6]" />
    <PackageDownload Include="Microsoft.WindowsDesktop.App.Ref" Version="[8.0.6]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.win-x64" Version="[8.0.6]" />
    <PackageDownload Include="Microsoft.NETCore.App.Host.win-x86" Version="[8.0.6]" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DotNetCampus.CommandLine" Version="4.2.0" />
    <PackageReference Include="Microsoft.Net.Compilers.Toolset" Version="4.11.0" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="WritePackagePaths" BeforeTargets="Build">
    <WriteLinesToFile File="$(OutputPath)PackagePaths.txt"
                      Lines="win-x64=$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x64\8.0.6\;win-x86=$(NuGetPackageRoot)microsoft.windowsdesktop.app.runtime.win-x86\8.0.6\;host-win-x64=$(NuGetPackageRoot)microsoft.netcore.app.host.win-x64\8.0.6\;host-win-x86=$(NuGetPackageRoot)microsoft.netcore.app.host.win-x86\8.0.6\;ref=$(NuGetPackageRoot)microsoft.windowsdesktop.app.ref\8.0.6\"
                      Overwrite="true" />
  </Target>

</Project>
